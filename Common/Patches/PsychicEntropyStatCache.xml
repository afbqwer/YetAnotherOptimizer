<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="YaOpt.Patches.Xml.PatchOperationSettingGate">
		<setting>OptPsychicEntropyCache</setting>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/StatDef[defName="PsychicEntropyMax" and not(cacheable)]</xpath>
			<value>
				<cacheable>true</cacheable>
			</value>
		</match>
	</Operation>
</Patch>
