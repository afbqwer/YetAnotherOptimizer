<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<YaOpt.CompatibilityDef MayRequire="Vortex.Kingfisher">
		<defName>Kingfisher</defName>
		<lockPatches>
			<!-- Since 0.6, Kingfisher pastes the body of its rewrite methods into the vanilla methods
			     via PurePatcher's [ReplaceMethod], so its own methods are dead code and the locks
			     have to target the vanilla method that actually runs. -->
			<LockPatch>
				<method>Verse.AI.AttackTargetFinder:BestAttackTarget</method>
			</LockPatch>
			<!-- These two are helper methods, still called by the pasted bodies. -->
			<LockPatch>
				<method>Kingfisher.Features.RefuelWorkCandidates:CandidatesFor</method>
			</LockPatch>
			<LockPatch>
				<method>Kingfisher.Features.ListerBuildingsRewrite:GetOrBuild</method>
			</LockPatch>
		</lockPatches>
	</YaOpt.CompatibilityDef>
</Defs>