<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<Optimize>true</Optimize>
		<DebugType>embedded</DebugType>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
		<!-- Assembly-CSharp is publicized so non-public vanilla members are reachable at compile
		     time. Publicizing only rewrites the copy the compiler sees; at runtime the original
		     assembly is loaded, so access checks still apply. IgnoresAccessChecksTo is the
		     mechanism CoreCLR honours. -->
		<PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>

		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</RimWorldDir>

		<IntermediateOutputPath>obj\$(Configuration)\net10.0\</IntermediateOutputPath>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith.Injection">
			<HintPath>$(RimWorldDir)Waylith.Injection.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="RimWorldWaylith.PrepatcherCompat">
			<HintPath>$(RimWorldDir)RimWorldWaylith.PrepatcherCompat.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
	</ItemGroup>

	<!-- Virtual members stay protected on purpose. Publicizing a virtual slot makes a bad
	     `public override` compile against a `Family` runtime slot, which is a type-load failure
	     rather than a compile error. Members we only *read* or *call* (never override) are
	     opted back in individually. -->
	<ItemGroup>
		<Publicize Include="0Harmony" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
		<Publicize Include="Assembly-CSharp" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
		<Publicize Include="Assembly-CSharp:Verse.Thing.MinTickIntervalRate" />
		<Publicize Include="Assembly-CSharp:Verse.Thing.MaxTickIntervalRate" />
		<Publicize Include="Assembly-CSharp:Verse.Thing.UpdateRateTickOffset" />
		<Publicize Include="Assembly-CSharp:Verse.ThingOwner`1.NotifyRemoved" />
		<!-- Social opinion fast path calls the raw worker query itself so the duplicate
		     CanGetThought inside ThoughtWorker.FailState is skipped. Never overridden here. -->
		<Publicize Include="Assembly-CSharp:RimWorld.ThoughtWorker.CurrentSocialStateInternal" />
	</ItemGroup>

	</Project>