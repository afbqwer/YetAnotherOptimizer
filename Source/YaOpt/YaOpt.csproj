<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<DebugType>embedded</DebugType>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
		<!-- Assembly-CSharp is publicized so non-public vanilla members are reachable at compile
		     time. Publicizing only rewrites the copy the compiler sees; at runtime the original
		     assembly is loaded, so access checks still apply. IgnoresAccessChecksTo is the
		     mechanism CoreCLR honours. -->
		<PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>

		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</RimWorldDir>

		<IntermediateOutputPath>obj\$(Configuration)\net10.0\</IntermediateOutputPath>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
	</PropertyGroup>

	<!-- Compatibility submodules and Prepatcher prepatches are intentionally excluded in 1.7:
	     mod compatibility/parallelism was retired, Prepatcher is built into the game. -->
	<ItemGroup>
		<Compile Remove="Patches\Compatibility\**\*.cs" />
		<Compile Remove="Patches\Prepatch\**\*.cs" />
		<!-- Depends on the Burst assembly, which cannot be built against the 1.7 math stubs. -->
		<Compile Remove="Patches\Verse_PawnRenderTree_TryGetMatrix.cs" />
		<!-- Multithreaded drawable-removal half of OptFastListerRemove; retired in 1.7. -->
		<Compile Remove="Patches\Verse_DynamicDrawManager_DeRegisterDrawable.cs" />
		<!-- Depend on retired compatibility/prepatch code. -->
		<Compile Remove="Helpers\GetCompHelper.cs" />
		<Compile Remove="Helpers\ParallelRegionTraverser.cs" />
		<Compile Remove="Patches\MultiTargets_ThingGetComp.cs" />
		<Compile Remove="Patches\Verse_ThingWithComps_InitializeComps.cs" />
		<Compile Remove="Patches\Verse_ThingOwnerUtility_AppendThingHoldersFromThings.cs" />
		<Compile Remove="Patches\ThreadSafe\Verse_RegionTraverser_BreadthFirstTraverse.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- The HAR need-condition fix applies to 1.7 as well: it reaches HAR only through
		     reflection and does not depend on any retired compatibility type. -->
		<Compile Include="Patches\Compatibility\HumanoidAlienRaces\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
	</ItemGroup>

	<ItemGroup>
		<Publicize Include="0Harmony" />
		<Publicize Include="Assembly-CSharp" />
	</ItemGroup>

	</Project>